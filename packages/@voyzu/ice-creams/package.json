{
  "name": "@voyzu/ice-creams",
  "version": "0.1.2",
  "description": "A best-practice, self-contained ice-cream management package.",
  "repository": "https://github.com/chrisjameslennon/voyzu-packages.git",
  "private": true,
  "type": "module",
  "voyzu": {
    "voyzu-package": true,
    "allowInstall": true,
    "dependencies": [],
    "settings": {
      "helpBaseUrl": "https://voyzu.gitbook.io/docs/"
    }
  },
  "exports": {
    "./voyzu-package": {
      "types": "./voyzu.package.ts",
      "import": "./voyzu.package.ts"
    },
    "./modules/ice-creams": {
      "types": "./modules/ice-creams/module.ts",
      "import": "./modules/ice-creams/module.ts"
    },
    "./ice-creams/pages.routes": {
      "types": "./modules/ice-creams/pages.routes.ts",
      "import": "./modules/ice-creams/pages.routes.ts"
    },
    "./ice-creams/http-api.routes": {
      "types": "./modules/ice-creams/http-api.routes.ts",
      "import": "./modules/ice-creams/http-api.routes.ts"
    },
    "./modules/reports": {
      "types": "./modules/reports/module.ts",
      "import": "./modules/reports/module.ts"
    },
    "./reports/pages.routes": {
      "types": "./modules/reports/pages.routes.ts",
      "import": "./modules/reports/pages.routes.ts"
    },
    "./reports/http-api.routes": {
      "types": "./modules/reports/http-api.routes.ts",
      "import": "./modules/reports/http-api.routes.ts"
    },
    "./types": {
      "types": "./types/index.ts",
      "import": "./types/index.ts"
    },
    "./modules/ice-creams/server": {
      "types": "./modules/ice-creams/server/index.ts",
      "import": "./modules/ice-creams/server/index.ts"
    }
  },
  "peerDependencies": {
    "@voyzu/capability": "^0.1.0",
    "@voyzu/types": "^0.1.0",
    "@voyzu/ui-components": "^0.1.0",
    "@voyzu/ui-layout": "^0.1.0",
    "@voyzu/ui-style": "^0.1.0",
    "@voyzu/ui-surface": "^0.1.0",
    "next": "^16",
    "react": "^19",
    "server-only": "^0.0.1",
    "typebox": "^1.3.7",
    "@voyzu/ui-business-components": "^0.1.0"
  }
}
