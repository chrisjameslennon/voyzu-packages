{
  "name": "@voyzu/inventory",
  "version": "0.1.0",
  "description": "Physical inventory and warehouse operations for Voyzu.",
  "repository": "https://github.com/chrisjameslennon/voyzu-packages.git",
  "private": true,
  "type": "module",
  "voyzu": {
    "voyzu-package": true,
    "allowInstall": true,
    "dependencies": [
      "@voyzu/organization"
    ],
    "settings": {
      "helpBaseUrl": "https://voyzu.gitbook.io/docs/"
    }
  },
  "exports": {
    "./voyzu-package": {
      "types": "./voyzu.package.ts",
      "import": "./voyzu.package.ts"
    },
    "./modules/items": {
      "types": "./modules/items/module.ts",
      "import": "./modules/items/module.ts"
    },
    "./core": {
      "types": "./modules/core/module.ts",
      "import": "./modules/core/module.ts"
    },
    "./core/types": {
      "types": "./modules/core/types/index.ts",
      "import": "./modules/core/types/index.ts"
    },
    "./items/pages.routes": {
      "types": "./modules/items/pages.routes.ts",
      "import": "./modules/items/pages.routes.ts"
    },
    "./items/http-api.routes": {
      "types": "./modules/items/http-api.routes.ts",
      "import": "./modules/items/http-api.routes.ts"
    },
    "./configuration/pages.routes": {
      "types": "./modules/configuration/pages.routes.ts",
      "import": "./modules/configuration/pages.routes.ts"
    },
    "./configuration/http-api.routes": {
      "types": "./modules/configuration/http-api.routes.ts",
      "import": "./modules/configuration/http-api.routes.ts"
    },
    "./stock/pages.routes": {
      "types": "./modules/stock/pages.routes.ts",
      "import": "./modules/stock/pages.routes.ts"
    },
    "./stock/http-api.routes": {
      "types": "./modules/stock/http-api.routes.ts",
      "import": "./modules/stock/http-api.routes.ts"
    },
    "./financial-activity/pages.routes": {
      "types": "./modules/financial-activity/pages.routes.ts",
      "import": "./modules/financial-activity/pages.routes.ts"
    },
    "./financial-activity/http-api.routes": {
      "types": "./modules/financial-activity/http-api.routes.ts",
      "import": "./modules/financial-activity/http-api.routes.ts"
    },
    "./financial-activity/types": {
      "types": "./modules/financial-activity/types/financial-activity.types.ts",
      "import": "./modules/financial-activity/types/financial-activity.types.ts"
    },
    "./reports/pages.routes": {
      "types": "./modules/reports/pages.routes.ts",
      "import": "./modules/reports/pages.routes.ts"
    },
    "./reports/http-api.routes": {
      "types": "./modules/reports/http-api.routes.ts",
      "import": "./modules/reports/http-api.routes.ts"
    },
    "./ui-surface/left-nav-header": {
      "types": "./ui-surface/left-nav-header.tsx",
      "import": "./ui-surface/left-nav-header.tsx"
    }
  },
  "peerDependencies": {
    "@voyzu/capability": "^0.1.0",
    "@voyzu/types": "^0.1.0",
    "@voyzu/ui-components": "^0.1.0",
    "@voyzu/ui-layout": "^0.1.0",
    "@voyzu/ui-style": "^0.1.0",
    "@voyzu/ui-surface": "^0.1.0",
    "next": "^16",
    "react": "^19",
    "server-only": "^0.0.1",
    "@voyzu/ui-business-components": "^0.1.0"
  }
}
