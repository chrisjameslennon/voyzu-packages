{
  "name": "@voyzu/inventory",
  "version": "0.1.0",
  "description": "Physical inventory and warehouse operations for Voyzu.",
  "repository": "https://github.com/chrisjameslennon/voyzu-packages.git",
  "private": true,
  "type": "module",
  "voyzu": {
    "voyzu-package": true,
    "allowInstall": true,
    "dependencies": ["@voyzu/erp-core"],
    "pageRootPaths": ["/inventory"],
    "apiRootPaths": ["/inventory"],
    "settings": {
      "helpBaseUrl": "https://voyzu.gitbook.io/docs/"
    }
  },
  "exports": {
    "./voyzu-package": {
      "types": "./voyzu.package.ts",
      "import": "./voyzu.package.ts"
    },
    "./navigation": {
      "types": "./navigation/index.ts",
      "import": "./navigation/index.ts"
    },
    "./navigation/left-nav-header": {
      "types": "./navigation/left-nav-header.tsx",
      "import": "./navigation/left-nav-header.tsx"
    },
    "./modules/items": {
      "types": "./modules/items/module.ts",
      "import": "./modules/items/module.ts"
    },
    "./core": {
      "types": "./modules/core/module.ts",
      "import": "./modules/core/module.ts"
    },
    "./core/types": {
      "types": "./modules/core/types/index.ts",
      "import": "./modules/core/types/index.ts"
    },
    "./items/pages.routes": {
      "types": "./modules/items/pages.routes.ts",
      "import": "./modules/items/pages.routes.ts"
    },
    "./items/api.routes": {
      "types": "./modules/items/api.routes.ts",
      "import": "./modules/items/api.routes.ts"
    },
    "./items/operations": {
      "types": "./modules/items/operations.ts",
      "import": "./modules/items/operations.ts"
    },
    "./configuration/pages.routes": {
      "types": "./modules/configuration/pages.routes.ts",
      "import": "./modules/configuration/pages.routes.ts"
    },
    "./configuration/api.routes": {
      "types": "./modules/configuration/api.routes.ts",
      "import": "./modules/configuration/api.routes.ts"
    },
    "./configuration/operations": {
      "types": "./modules/configuration/operations.ts",
      "import": "./modules/configuration/operations.ts"
    },
    "./stock/pages.routes": {
      "types": "./modules/stock/pages.routes.ts",
      "import": "./modules/stock/pages.routes.ts"
    },
    "./stock/api.routes": {
      "types": "./modules/stock/api.routes.ts",
      "import": "./modules/stock/api.routes.ts"
    },
    "./stock/operations": {
      "types": "./modules/stock/operations.ts",
      "import": "./modules/stock/operations.ts"
    },
    "./reports/pages.routes": {
      "types": "./modules/reports/pages.routes.ts",
      "import": "./modules/reports/pages.routes.ts"
    },
    "./reports/api.routes": {
      "types": "./modules/reports/api.routes.ts",
      "import": "./modules/reports/api.routes.ts"
    },
    "./reports/operations": {
      "types": "./modules/reports/operations.ts",
      "import": "./modules/reports/operations.ts"
    }
  },
  "peerDependencies": {
    "@voyzu/audit": "^0.1.0",
    "@voyzu/capability": "^0.1.0",
    "@voyzu/erp-core": "^0.1.0",
    "@voyzu/types": "^0.1.0",
    "@voyzu/ui-components": "^0.1.0",
    "@voyzu/ui-layout": "^0.1.0",
    "@voyzu/ui-style": "^0.1.0",
    "@voyzu/ui-surface": "^0.1.0",
    "next": "^16",
    "react": "^19",
    "server-only": "^0.0.1"
  }
}
