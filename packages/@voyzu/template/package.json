{
  "name": "@voyzu/template",
  "version": "0.1.0",
  "description": "A minimal, single-table reference package for Voyzu development.",
  "repository": "https://github.com/chrisjameslennon/voyzu-packages.git",
  "private": true,
  "type": "module",
  "voyzu": {
    "voyzu-package": true,
    "allowInstall": true,
    "dependencies": [],
    "pageRootPaths": ["/template"],
    "apiRootPaths": ["/template"],
    "settings": {
      "helpBaseUrl": "https://voyzu.gitbook.io/docs/"
    }
  },
  "exports": {
    "./voyzu-package": {
      "types": "./voyzu.package.ts",
      "import": "./voyzu.package.ts"
    },
    "./navigation": {
      "types": "./navigation/index.ts",
      "import": "./navigation/index.ts"
    },
    "./modules/template": {
      "types": "./modules/template/module.ts",
      "import": "./modules/template/module.ts"
    },
    "./template/operations": {
      "types": "./modules/template/operations.ts",
      "import": "./modules/template/operations.ts"
    },
    "./template/pages.routes": {
      "types": "./modules/template/pages.routes.ts",
      "import": "./modules/template/pages.routes.ts"
    },
    "./template/api.routes": {
      "types": "./modules/template/api.routes.ts",
      "import": "./modules/template/api.routes.ts"
    },
    "./modules/reports": {
      "types": "./modules/reports/module.ts",
      "import": "./modules/reports/module.ts"
    },
    "./reports/operations": {
      "types": "./modules/reports/operations.ts",
      "import": "./modules/reports/operations.ts"
    },
    "./reports/pages.routes": {
      "types": "./modules/reports/pages.routes.ts",
      "import": "./modules/reports/pages.routes.ts"
    },
    "./reports/api.routes": {
      "types": "./modules/reports/api.routes.ts",
      "import": "./modules/reports/api.routes.ts"
    },
    "./types": {
      "types": "./modules/types/index.ts",
      "import": "./modules/types/index.ts"
    },
    "./modules/template/server": {
      "types": "./modules/template/server/index.ts",
      "import": "./modules/template/server/index.ts"
    }
  },
  "peerDependencies": {
    "@voyzu/audit": "^0.1.0",
    "@voyzu/capability": "^0.1.0",
    "@voyzu/types": "^0.1.0",
    "@voyzu/ui-components": "^0.1.0",
    "@voyzu/ui-layout": "^0.1.0",
    "@voyzu/ui-style": "^0.1.0",
    "@voyzu/ui-surface": "^0.1.0",
    "next": "^16",
    "react": "^19",
    "server-only": "^0.0.1",
    "typebox": "^1.3.7"
  }
}
