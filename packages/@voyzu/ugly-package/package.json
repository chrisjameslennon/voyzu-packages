{
  "name": "@voyzu/ugly-package",
  "version": "0.1.1",
  "description": "A deliberately ugly demonstration of the freedom available to Voyzu package developers.",
  "repository": "https://github.com/chrisjameslennon/voyzu-packages.git",
  "private": true,
  "type": "module",
  "voyzu": {
    "voyzu-package": true,
    "allowInstall": true,
    "dependencies": [],
    "pageRootPaths": ["/ugly-package"],
    "apiRootPaths": ["/ugly-package"],
    "settings": {
      "helpBaseUrl": "https://voyzu.gitbook.io/docs/"
    }
  },
  "exports": {
    "./voyzu-package": {
      "types": "./voyzu.package.ts",
      "import": "./voyzu.package.ts"
    },
    "./navigation/top-nav": {
      "types": "./navigation/top-nav.topnav.ts",
      "import": "./navigation/top-nav.topnav.ts"
    }
  },
  "dependencies": {
    "cat-names": "^4.0.0"
  },
  "peerDependencies": {
    "@voyzu/types": "^0.1.0",
    "next": "^16",
    "react": "^19",
    "server-only": "^0.0.1",
    "shiki": "^4.4.1"
  }
}
