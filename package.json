{
  "name": "voyzu-packages",
  "description": "Voyzu package development",
  "scripts": {
    "voyzu:add-repo": "npm --prefix .run run voyzu:add-repo --",
    "voyzu:install": "npm --prefix .run run voyzu:install --",
    "voyzu:update": "npm --prefix .run run voyzu:update",
    "voyzu:update-repos": "npm --prefix .run run voyzu:update-repos",
    "voyzu:update-repo": "npm --prefix .run run voyzu:update-repo --",
    "voyzu:initialize": "npm --prefix .run run voyzu:initialize",
    "voyzu:install-package": "npm --prefix .run run voyzu:install-package --",
    "voyzu:uninstall": "npm --prefix .run/voyzu run voyzu:uninstall-package --",
    "voyzu:uninstall-package": "npm --prefix .run run voyzu:uninstall-package --",
    "voyzu:list-packages": "npm --prefix .run run voyzu:list-packages",
    "voyzu:link-package": "npm --prefix .run run voyzu:link-package --",
    "voyzu:link-packages": "npm --prefix .run run voyzu:link-packages",
    "voyzu:compose": "npm --prefix .run run voyzu:compose",
    "voyzu:build-api-reference": "npm --prefix .run run voyzu:build-api-reference",
    "voyzu:run-script": "npm --prefix .run run voyzu:run-script --",
    "voyzu:dev": "npm run dev",
    "voyzu:build": "npm run build",
    "voyzu:start": "npm start",
    "dev": "npm --prefix .run run dev",
    "build": "npm --prefix .run run build",
    "prestart": "npm run build",
    "start": "npm --prefix .run run start"
  },
  "voyzu": {
    "mode": "development",
    "platform": {
      "repository": "https://github.com/chrisjameslennon/voyzu.git",
      "branch": "0.2"
    }
  }
}
