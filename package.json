{
  "name": "voyzu-modules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/@voyzu-modules/*",
    ".dev/voyzu/packages/@voyzu/*"
  ],
  "scripts": {
    "create-dev": "npm exec --yes --package=github:chrisjameslennon/create-voyzu#main -- create-voyzu dev",
    "re-install": "npm run create-dev -- --force",
    "compose": "node ./scripts/compose.mjs",
    "dev": "npm --prefix .dev run dev",
    "build": "npm --prefix .dev run build",
    "typecheck": "npm --prefix .dev run typecheck"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "next": "^16.2.10",
    "react": "^19.2.0",
    "server-only": "^0.0.1",
    "typescript": "^6.0.3"
  }
}
